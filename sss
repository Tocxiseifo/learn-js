.nav-bar{
    width: 60%;
    height: 75px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: white;
    position: relative;
    left: 400px;
    top: 15px;
    border-radius: 25px;
    /* border: 5px solid ; */
    box-shadow: -1px 10px 8px 10px black ;
}
.nav-bar img{
    width: 50px;
    border-radius: 50%;
    height: 50px;
    margin-left: 20px;
    cursor: pointer;
    object-fit: fill;
    transition: all , 0.5s;
    &:hover{
        transform: scale(1.2);
        transition: 0.3s;
        filter: brightness(70%);
    }
}
.nav-bar .img{
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.nav-bar .img h3{
    margin-left: 10px;
    color: black;
    
}
.nav-bar .txt a {
    margin-left: 15px;
    color: black;
    text-transform: capitalize;
    text-decoration: none;
    font-size: 18px;
    position: relative;
}
.nav-bar .txt a::before,.nav-bar .txt a::after {
    content: '';
    position: absolute;
    height: 2px;
    width: 0;
    background: black;
    transition: 0.4s;
}
.nav-bar .txt a::before{
    bottom: 0;
}
.nav-bar .txt a::after{
    left: 0;
}
.nav-bar .txt a:hover::before{
    width: 100%;
}
.nav-bar .txt{
    margin-right: 20px;
}
